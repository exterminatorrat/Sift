{
  "expo": {
    "name": "Sift",
    "slug": "sift",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F9FA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.sift.mvp",
      "infoPlist": {
        "NSCameraUsageDescription": "Sift uses your camera to scan restaurant menus for possible allergen risks.",
        "NSPhotoLibraryUsageDescription": "Sift lets you upload menu photos for possible allergen risk analysis."
      }
    },
    "android": {
      "package": "app.sift.mvp",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
