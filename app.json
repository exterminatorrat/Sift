{
  "expo": {
    "name": "Sift",
    "slug": "sift",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F9FA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sift.mvp"
    },
    "android": {
      "package": "app.sift.mvp"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
