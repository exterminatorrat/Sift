{
  "name": "sift-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:release": "node scripts/check-release.mjs && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "verify": "npm run check && npm run build && node scripts/verify-build.mjs",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@lucide/astro": "^1.24.0",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
