<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/brand/sift-favicon.svg" type="image/svg+xml" />
    <title>Sift social card</title>
    <style>
      @font-face { font-family: "Source Serif 4"; src: url("/fonts/source-serif-4-semibold.ttf") format("truetype"); font-weight: 600; }
      @font-face { font-family: "Source Serif 4"; src: url("/fonts/source-serif-4-regular.ttf") format("truetype"); font-weight: 400; }
      @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-weight: 600; }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; overflow: hidden; }
      body { background: #fff; color: #182321; font-family: "Source Serif 4", Georgia, serif; }
      .card { display: grid; grid-template-columns: 1.08fr .92fr; height: 630px; padding: 52px 64px; position: relative; width: 1200px; }
      .card::before { border: 1px solid #e6dccf; border-radius: 50%; content: ""; height: 490px; position: absolute; right: 56px; top: 70px; width: 490px; }
      .brand { align-items: center; color: #104c48; display: flex; font-size: 34px; font-weight: 600; gap: 13px; left: 64px; position: absolute; top: 48px; }
      .mark { display: block; height: 42px; width: 42px; }
      .copy { align-self: center; padding-top: 54px; position: relative; z-index: 2; }
      .eyebrow { color: #18746e; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; letter-spacing: .08em; margin: 0 0 18px; text-transform: uppercase; }
      h1 { font-size: 60px; letter-spacing: -.035em; line-height: 1.02; margin: 0 0 22px; max-width: 555px; }
      .lede { color: #5f6f6b; font-size: 21px; line-height: 1.36; margin: 0; max-width: 500px; }
      .phones { align-items: center; display: flex; gap: 22px; justify-content: center; position: relative; z-index: 2; }
      .phone { background: linear-gradient(105deg,#222725,#717874 10%,#171b19 48%,#3e4441 86%,#747b77 94%,#242927); border: 1px solid #737a76; border-radius: 35px; box-shadow: 0 24px 52px rgba(11,41,39,.2); padding: 5px; position: relative; width: 194px; }
      .phone::after { background: #020303; border: 1px solid #26302d; border-radius: 999px; content: ""; height: 14px; left: 50%; position: absolute; top: 12px; transform: translateX(-50%); width: 54px; }
      .phone:first-child { transform: translateY(26px); }
      .phone:last-child { transform: translateY(-22px); }
      .phone img { background: #fff8ef; border: 2px solid #050807; border-radius: 29px; display: block; padding-top: 14px; width: 100%; }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="brand"><img class="mark" src="/brand/sift-mark.svg" alt="" width="42" height="42" />Sift</div>
      <section class="copy">
        <p class="eyebrow">Questions, not guarantees</p>
        <h1>Know what to ask before you eat.</h1>
        <p class="lede">Menu guidance for people with food allergies and their caregivers.</p>
      </section>
      <section class="phones" aria-label="Sift app screens">
        <div class="phone"><img src="/app/home.png" alt="" width="390" height="844" /></div>
        <div class="phone"><img src="/app/results-dishes.png" alt="" width="390" height="844" /></div>
      </section>
    </main>
  </body>
</html>
