---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Contact Sift"
  description="Contact Sift for product support, privacy and account questions, accessibility feedback, or product feedback."
  path="/contact"
  schemaType="ContactPage"
>
  <PageHero
    title="Tell us what you need."
    description="Choose the address that best fits your question. There is no form between you and our inbox."
    compact
  />

  <section class="content-section">
    <div class="shell">
      <div class="contact-grid">
        <article class="contact-card">
          <h2>Support and account questions</h2>
          <p>
            For help using Sift, privacy questions, account deletion, accessibility barriers, or a problem with a
            scan, email <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>.
          </p>
        </article>
        <article class="contact-card">
          <h2>Product feedback</h2>
          <p>
            For ideas, workflow feedback, or something you think Sift should explain more clearly, email
            <a href={`mailto:${site.feedbackEmail}`}>{site.feedbackEmail}</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="content-section content-section--tint">
    <div class="shell prose">
      <h2>Before you email</h2>
      <p>
        A short description of what happened, the screen you were using, and your device and app version can help
        us understand a product issue. If a screenshot is useful, remove names, allergy details, restaurant order
        information, and anything else you do not want to share.
      </p>
      <div class="callout callout--warning">
        <strong>Do not email sensitive health information, allergy profile details, or unredacted personal data unless our support team asks for specific information and explains why it is needed.</strong>
      </div>
      <p>
        To report a suspected privacy or security issue, send a brief, non-sensitive description to
        <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>. Please do not include exploit code, account
        credentials, private records, or another person's information in an initial message.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="shell prose">
      <h2>Sift is not an emergency service</h2>
      <p>
        Do not use these email addresses for an allergic reaction or other urgent medical situation. Contact local
        emergency services and follow the emergency plan provided by your healthcare professional.
      </p>
      <p>For common product questions, visit <a href="/support">Sift Support</a>.</p>
    </div>
  </section>
</BaseLayout>
