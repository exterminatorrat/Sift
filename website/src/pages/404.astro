---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Sift"
  description="The page you requested could not be found."
  path="/404"
  noindex
>
  <section class="not-found">
    <div class="shell not-found__inner">
      <p class="eyebrow">404</p>
      <h1>This page is off the menu.</h1>
      <p>The link may have changed, or the page may no longer be available.</p>
      <div class="not-found__actions">
        <a class="button button--primary" href="/">Return home</a>
        <a class="button button--secondary" href="/support">Visit support</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 66vh;
    padding-block: clamp(90px, 14vw, 180px);
  }

  .not-found__inner {
    max-width: 900px;
  }

  h1 {
    margin-bottom: 24px;
    max-width: 760px;
  }

  .not-found__inner > p:not(.eyebrow) {
    color: var(--ink-muted);
    font-size: 1.2rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
</style>
