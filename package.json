{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eval:ai": "node scripts/run-ai-evals.mjs",
    "eval:ai:prepare-images": "node scripts/prepare-ai-eval-images.mjs",
    "eval:ai:multi-page:generate": "node scripts/generate-ai-multipage-fixtures.mjs --write",
    "eval:ai:multi-page:check": "node scripts/generate-ai-multipage-fixtures.mjs --check && node scripts/ai-evals/multi-page-corpus-self-test.mjs",
    "eval:ai:prepare-images:multi-page": "node scripts/prepare-ai-eval-images.mjs --manifest docs/ai-evals/multi-page-cases.json --output output/ai-evals/preprocessed-multi-page --version benchmark-jpeg-1600-q72-multipage-v1",
    "eval:ai:manual:prepare:multi-page": "node scripts/ai-evals/prepare-manual-run.mjs --manifest docs/ai-evals/multi-page-cases.json --preprocessed-manifest output/ai-evals/preprocessed-multi-page/manifest.json --cases all --run-id sift-multi-page-diagnostic",
    "eval:ai:live:multi-page": "node scripts/run-live-ai-evals.mjs run --phase multi-page-diagnostic --manifest docs/ai-evals/multi-page-cases.json --preprocessed-manifest output/ai-evals/preprocessed-multi-page/manifest.json --cases all --repeat 1",
    "eval:ai:manual:prepare": "node scripts/ai-evals/prepare-manual-run.mjs",
    "eval:ai:manual:self-test": "node scripts/ai-evals/manual-workbench/self-test.mjs",
    "eval:ai:manual:score": "node scripts/ai-evals/score-manual-run.mjs",
    "eval:ai:experiments": "node scripts/ai-evals/prepare-experiment-matrix.mjs",
    "eval:ai:holdout:promote": "node scripts/ai-evals/promote-holdout.mjs",
    "eval:ai:sources": "node scripts/ai-evals/validate-real-world-source-candidates.mjs --self-test",
    "eval:ai:sources:acquire": "node scripts/ai-evals/acquire-real-world-source-candidates.mjs",
    "eval:ai:sources:acquire:self-test": "node scripts/ai-evals/acquire-real-world-source-candidates.mjs --self-test",
    "eval:ai:human:generate": "node scripts/ai-evals/human-review/generate.mjs",
    "eval:ai:human:score": "node scripts/ai-evals/human-review/score.mjs",
    "eval:ai:human:self-test": "node scripts/ai-evals/human-review/self-test.mjs",
    "eval:ai:failures": "node scripts/ai-evals/validate-failure-registry.mjs",
    "eval:ai:architecture": "node scripts/ai-evals/run-architecture-checks.mjs",
    "eval:ai:live": "node scripts/run-live-ai-evals.mjs",
    "test:backend:smoke": "node scripts/run-backend-smoke.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.7",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.10",
    "jimp-compact": "0.16.1",
    "typescript": "~5.9.2"
  }
}
