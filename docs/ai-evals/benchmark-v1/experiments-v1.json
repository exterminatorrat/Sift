  "decisionPolicy": {
    "purpose": "Exploratory factor isolation before a frozen full-development confirmation run.",
    "requiredForEveryTreatment": [
      "zero severe directly listed allergen misses",
      "zero forbidden safety claims",
      "zero invalid client-visible results",
      "no poor-image retake regression",
      "no directional critical-risk downgrade"
    ],
    "shipRule": "A treatment is only eligible for confirmation when it passes every safety invariant and improves at least one predeclared quality, availability, latency, or token metric without worsening another safety-critical metric. No six-case experiment alone can authorize shipment; the selected treatment must pass the full development, holdout, repeat, and deployed-canary gates."
  },
  "experiments": [
    {
      "id": "preprocessing-long-edge",
      "factor": "preprocessing.maxLongEdge",
      "question": "Does a 2048-pixel long edge improve small-text and difficult-menu evidence extraction over the app-parity 1600-pixel baseline?",
      "arms": [
        {
          "id": "control-1600",
          "preprocessing": {
            "maxLongEdge": 1600,
            "jpegQuality": 72
          },
          "generation": {
            "thinkingLevel": "low",
            "mediaResolution": "MEDIA_RESOLUTION_UNSPECIFIED",
            "promptContentOrder": "instruction_first"
          }
        },
        {
